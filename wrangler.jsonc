{
  // Final Duel (Arena + Conquest) on Cloudflare Workers.
  // dist/ is committed, so deploying needs no build step: `npx wrangler deploy`.
  // Each Conquest room is one ConquestRoom Durable Object running the authoritative match.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "final-duel-conquest",
  "main": "src/server/worker.ts",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/ws/*", "/turn"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ConquestRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConquestRoom"] }],
  // Arena's relay credentials come from the existing final-gate-turn Worker.
  "services": [{ "binding": "TURN", "service": "final-gate-turn" }]
}
